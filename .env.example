# Optional manual backend settings.
# The Electron app normally manages these automatically.

# Isolate local config, logs, secrets, temp audio, and SQLite stores.
# STEERVOX_HOME=/tmp/steervox-dev

# Pin the backend port for manual debugging.
# STEERVOX_BACKEND_PORT=8055

# Required only when calling protected backend APIs manually.
# STEERVOX_LOCAL_API_TOKEN=replace-with-a-random-local-token

# Optional release signing variables.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Company (TEAMID)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID
